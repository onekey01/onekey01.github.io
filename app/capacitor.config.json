{
  "appId": "kr.mumuride.app",
  "appName": "무무 라이딩",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b1220"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "channelUrl": "",
      "updateUrl": "",
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}